# Backend LLM (scripts/llm_backend.py). "ollama" = comportement actuel
# inchangé (local, CPU). "together" = cloud, résout la dégradation Ollama
# sous charge soutenue (checklist.md, 2026-08-07) mais envoie les chunks
# du document analysé à un service externe -- ne pas utiliser en prod sur
# des documents bancaires confidentiels sans validation explicite.
LLM_BACKEND=ollama

# Requis si LLM_BACKEND=together. Créer sur https://together.ai (Manage API
# keys). Ne JAMAIS commiter la vraie valeur -- ce fichier est un template,
# le vrai .env est gitignored.
TOGETHER_API_KEY=

# Optionnel -- défaut selon le backend si absent (qwen3:4b-instruct pour
# ollama, Qwen/Qwen3.5-9B pour together).
# LLM_MODEL=

# Backend de repli si le backend principal échoue (down, rate-limit, clé
# invalide). Vide ("") pour désactiver le fallback.
LLM_FALLBACK=ollama

# Requêtes/seconde max vers un backend cloud -- ignoré pour ollama (pas de
# rate limit externe en local). Ajuster selon le tier Together.
LLM_RATE_LIMIT=10

# Existant, inchangé -- URL du serveur Ollama (container "ollama" en Docker).
OLLAMA_HOST=http://localhost:11434
